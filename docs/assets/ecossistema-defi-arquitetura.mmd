flowchart TB
    subgraph Atores["Atores"]
        M["Membros"]
        D["Doadores"]
        C["Compradores"]
        ADM["Administração"]
        SIG["Signatários M-de-N"]
    end

    subgraph OffChain["Off-chain É Nóis"]
        FE["Dashboard / Frontend"]
        VAL["Serviço de comprovação<br/>de participação (EIP-712)"]
        RAMP["On-ramp<br/>Circle / provedor BRLA"]
    end

    subgraph Gov["Governança on-chain"]
        MS["Multisig M-de-N<br/>M = teto(2N/3)"]
        TL["Timelock ≥ 48h"]
        PZ["Pausa emergencial<br/>(escopo restrito)"]
    end

    subgraph Arc["Constelação de contratos — Rede Arc (EVM, gas em USDC)"]
        direction TB
        REG["ContractRegistry"]
        PRE["RewardsDistributor<br/>premiações e NFTs"]
        FAI["FaiscaToken<br/>ERC-20"]
        NFT["EnoisNFT<br/>ERC-1155 / ERC-721"]
        SWP["EnoisSwap<br/>AMM x·y=k — Faísca ⇄ USDC"]
        TRS["Treasury<br/>caixa + reserva swap + capital"]

        subgraph Adapters["Adapters — allowlist da governança"]
            INV["IInvestmentAdapter<br/>depósito · saque · valoração"]
            PRD["IProductAdapter<br/>cobrança · liquidação"]
        end
    end

    subgraph Ext["Ativos e protocolos externos"]
        USDC["USDC"]
        BRLA["BRLA"]
        V4626["Vaults ERC-4626"]
        LEND["Aave / Morpho"]
        RWA["Ondo · Securitize · outros"]
        SITE["Produtos e serviços<br/>vendidos no site"]
    end

    M & D & C & ADM --> FE
    RAMP --> FE
    FE -->|descobre endereços| REG
    FE -->|usa módulos| Arc
    VAL -->|autorização EIP-712| PRE

    SIG --> MS --> TL
    TL -->|operações aprovadas| TRS
    TL -.->|políticas e upgrades| Arc
    PZ -.->|pausa seletiva| Arc

    D -->|doação USDC/BRLA| TRS
    PRE -->|mint autorizado| FAI
    PRE -->|mint de edições| NFT
    TRS -->|financia reserva| SWP
    TRS -->|orçamento de emissão| FAI
    TRS -->|políticas administrativas| NFT
    TRS --> INV & PRD

    SWP <--> FAI
    SWP <--> USDC
    INV --> V4626 & LEND & RWA
    PRD --> SITE
    TRS -.->|custódia| USDC & BRLA

    classDef actor fill:#FFE0B2,stroke:#E65100,stroke-width:1px,color:#212121;
    classDef offchain fill:#B2DFDB,stroke:#00695C,stroke-width:1px,color:#212121;
    classDef gov fill:#FFCCBC,stroke:#BF360C,stroke-width:1px,color:#212121;
    classDef contract fill:#BBDEFB,stroke:#1565C0,stroke-width:1px,color:#212121;
    classDef treasury fill:#64B5F6,stroke:#0D47A1,stroke-width:3px,color:#0D1B2A;
    classDef token fill:#FFF59D,stroke:#F9A825,stroke-width:2px,color:#212121;
    classDef adapter fill:#E1BEE7,stroke:#6A1B9A,stroke-width:1px,color:#212121;
    classDef external fill:#CFD8DC,stroke:#455A64,stroke-width:1px,color:#212121;

    class M,D,C,ADM,SIG actor;
    class FE,VAL,RAMP offchain;
    class MS,TL,PZ gov;
    class REG,PRE,NFT,SWP contract;
    class TRS treasury;
    class FAI token;
    class INV,PRD adapter;
    class USDC,BRLA,V4626,LEND,RWA,SITE external;

    style Atores fill:#FFF8E1,stroke:#F9A825,stroke-width:2px,color:#212121;
    style OffChain fill:#E0F2F1,stroke:#00897B,stroke-width:2px,color:#212121;
    style Gov fill:#FBE9E7,stroke:#E64A19,stroke-width:2px,color:#212121;
    style Arc fill:#E3F2FD,stroke:#1E88E5,stroke-width:2px,color:#212121;
    style Adapters fill:#F3E5F5,stroke:#8E24AA,stroke-width:2px,color:#212121;
    style Ext fill:#ECEFF1,stroke:#607D8B,stroke-width:2px,color:#212121;
